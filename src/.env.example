# Opção A — banco na nuvem (Supabase, Neon etc.): defina DATABASE_URL.
# Tem prioridade sobre as variáveis abaixo se ambas estiverem definidas.
# DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# Opção B — Postgres local:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abcs
DB_USER=postgres
DB_PASSWORD=

# Webhook de produção do n8n; no Actions, cadastre como environment secrets.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# OAuth do Google (Sheets/Drive). Gere o token local com: python google_auth.py
# No Actions, cadastre GOOGLE_TOKEN_JSON com o conteúdo de src/token_google.json.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_SCOPES="https://www.googleapis.com/auth/spreadsheets https://www.googleapis.com/auth/drive.file"

# Planilha "Monitoramento de Proposições - ABCS" (id na URL), usada por comparar_acompanhamento.py.
GOOGLE_SHEET_MONITORAMENTO_ID=

# Módulo /legislativo (virada). Valores só no cofre e no src/.env local; nunca versionados.
# DATABASE_URL_SP: admin do projeto Supabase novo de produção (sa-east-1). Todo comando de escrita
#   roda com DATABASE_URL="$DATABASE_URL_SP" e confere current_database() e o ref antes.
# LEGISLATIVO_APP_DATABASE_URL: papel legislativo_app (aplicação Next.js).
# LEGISLATIVO_N8N_DATABASE_URL: papel legislativo_n8n (fluxo de inclusão).
# LEGISLATIVO_N8N_LEITURA_DATABASE_URL: papel legislativo_n8n_leitura (fluxo principal do n8n).
DATABASE_URL_SP=
LEGISLATIVO_APP_DATABASE_URL=
LEGISLATIVO_N8N_DATABASE_URL=
LEGISLATIVO_N8N_LEITURA_DATABASE_URL=
