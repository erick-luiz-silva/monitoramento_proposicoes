	column acompanhada
		dataType: boolean
		lineageTag: 1e11d3ca-a84c-484f-bd53-5a7a5a8009f8
		summarizeBy: none
		sourceColumn: acompanhada

		annotation SummarizationSetBy = Automatic

	column em_radar
		dataType: boolean
		lineageTag: b20411df-dba8-4e86-8628-d09a2049811b
		summarizeBy: none
		sourceColumn: em_radar

		annotation SummarizationSetBy = Automatic

	/// Entra no painel: acompanhada ou marcada SIM na aba "Proposições", sem as marcadas NÃO e sem as encerradas
	/// (arquivada ou transformada em norma). Mesma regra do e-mail diário; decidido com a Ana em 20/10/2026
	column em_painel =
			VAR _relevancia = UPPER(TRIM(LOOKUPVALUE('gold dim_relevancia'[relevancia], 'gold dim_relevancia'[id_proposicao], [id_proposicao])))
			VAR _encerrada = [situacao_atual] IN {"Arquivada", "Transformado em Norma Jurídica"}
			RETURN ([acompanhada] || _relevancia = "SIM") && NOT (_relevancia IN {"NÃO", "NAO"}) && NOT _encerrada
		dataType: boolean
		lineageTag: 5d9a2c7e-1f4b-4e8a-b3d6-9c0e7a2f4b18
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column sigla_tipo
		dataType: string
		lineageTag: 2c8e5a1f-7d3b-4e9a-b6c4-1f0d8e2a5c73
		summarizeBy: none
		sourceColumn: sigla_tipo

		annotation SummarizationSetBy = Automatic

	column data_apresentacao
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 9b4d2f7e-3a1c-4e8b-a5d6-7c0e3f9b1a24
		summarizeBy: none
		sourceColumn: data_apresentacao

		annotation SummarizationSetBy = Automatic

	/// Ano de apresentação da proposição (gráfico por ano)
	column ano_apresentacao = YEAR([data_apresentacao])
		dataType: int64
		formatString: 0
		lineageTag: 4f7a1c9e-2d5b-4b8e-9a3c-6e1f8d0b2c57
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Origem do autor principal: deputado, Senado (projeto de senador) ou Poder Executivo
	column origem_autor =
			SWITCH(
			    TRUE(),
			    [tipo_autor_principal] = "Deputado(a)", "Deputado(a)",
			    CONTAINSSTRING([autor_principal], "Senado"), "Senado",
			    CONTAINSSTRING([tipo_autor_principal], "Executivo"), "Poder Executivo",
			    [tipo_autor_principal]
			)
		dataType: string
		lineageTag: 7e2b9d4a-1f6c-4a3e-8d5b-0c9a7e2f4b61
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Partido para os gráficos: autor que é órgão (Senado, Executivo) não tem partido
	column partido_exibicao =
			IF(
			    ISBLANK([partido_autor_principal]) || [partido_autor_principal] = "",
			    [origem_autor] & " (sem partido)",
			    [partido_autor_principal]
			)
		dataType: string
		lineageTag: 3a6d0f8c-5e2b-4c7a-9f1d-8b4e2a6c0d95
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// UF para os gráficos: autor que é órgão (Senado, Executivo) não tem UF
	column uf_exibicao = IF(ISBLANK([uf_autor_principal]) || [uf_autor_principal] = "", [origem_autor] & " (sem UF)", [uf_autor_principal])
		dataType: string
		lineageTag: 0f5c2a8e-6d3b-4e1a-9b7c-4a8e1d5f2c36
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition vw_monitoramento = m
		mode: import
		source =
				let
				    Fonte = fnSupabaseGold("vw_monitoramento", "id_proposicao", {{"id_proposicao", Int64.Type}, {"identificacao", type text}, {"ementa", type text}, {"autor_principal", type text}, {"tipo_autor_principal", type text}, {"partido_autor_principal", type text}, {"uf_autor_principal", type text}, {"situacao_atual", type text}, {"orgao_atual", type text}, {"nome_orgao_atual", type text}, {"ultima_movimentacao", type text}, {"data_ultima_movimentacao", type datetime}, {"dias_sem_movimentacao", Int64.Type}, {"keywords_encontradas", type text}, {"link_direto", type text}, {"acompanhada", type logical}, {"em_radar", type logical}, {"sigla_tipo", type text}, {"data_apresentacao", type datetime}}),
				    NomePartidoUF = Table.AddColumn(Fonte, "Nome_Partido_UF", each [autor_principal] & " " & [partido_autor_principal] & "/" & [uf_autor_principal], type text)
				in
				    NomePartidoUF

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

