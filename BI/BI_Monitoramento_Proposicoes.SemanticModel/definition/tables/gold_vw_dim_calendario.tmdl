	partition vw_dim_calendario = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2023, 1, 1), DATE(2027, 12, 31)),
				    "Ano", YEAR([Date]),
				    "Mês Num", MONTH([Date]),
				    "Mês Nome", FORMAT([Date], "MMMM"),
				    "Ano-Mês", FORMAT([Date], "YYYY-MM")
				)
				
				```

