{
  "name": "ABCS Monitoramento Legislativo",
  "dataColors": [
    "#00533A",
    "#09814A",
    "#53AF33",
    "#1F5FA8",
    "#7A5AA6",
    "#0E8A8A",
    "#8A6D3B",
    "#5C6B73"
  ],
  "background": "#FFFFFF",
  "foreground": "#14231B",
  "foregroundNeutralSecondary": "#4A5A51",
  "foregroundNeutralTertiary": "#6B7770",
  "backgroundLight": "#F7F8F7",
  "backgroundNeutral": "#E3E8E5",
  "tableAccent": "#00533A",
  "hyperlink": "#09814A",
  "headingColor": "#14231B",
  "firstLevelElements": "#4A5A51",
  "secondLevelElements": "#C9D1CC",
  "good": "#09814A",
  "neutral": "#EAAA08",
  "bad": "#D92D20",
  "maximum": "#00533A",
  "center": "#F7F8F7",
  "minimum": "#FFFFFF",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#14231B"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#14231B"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#14231B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4A5A51"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#14231B"
              }
            },
            "alignment": "left"
          }
        ],
        "visualHeader": [
          {
            "show": true
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E3E8E5"
              }
            },
            "rowPadding": 4,
            "textSize": 11
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#14231B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F2F5F3"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#14231B"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#14231B"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 11,
            "wordWrap": true
          }
        ],
        "total": [
          {
            "totals": false
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#4A5A51"
              }
            },
            "textSize": 10
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#14231B"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F7F8F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F7F8F7"
              }
            }
          }
        ]
      }
    }
  }
}